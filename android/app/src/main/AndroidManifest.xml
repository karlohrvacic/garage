<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Location powers only the optional nearby-stations sorting; the app is
         fully usable without it, so GPS-less devices stay supported. -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application
        android:label="Garage"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Turns the intent's data URI into Flutter's initial route, which
                 is how every link into this app reaches go_router: the invite
                 and confirmation links below, the app icon's fill-up shortcut,
                 and the home-screen widget. Stated rather than left to the
                 engine's default, because when it is off nothing errors — the
                 activity simply starts on the dashboard and the URL is
                 dropped, which looks exactly like a working launch. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="true"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Invite links. android:autoVerify makes Android fetch
                 https://garage.hrva.cc/.well-known/assetlinks.json at install
                 time and, if this app's signing certificate is listed there,
                 open /join/<code> here instead of in the browser. Without a
                 matching fingerprint the link still works — it just opens the
                 web app, which is the intended fallback for someone who has
                 not installed this yet. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="garage.hrva.cc"
                    android:pathPrefix="/join"/>
                <!--
                  Confirmation and password-reset links. Claimed here so the
                  link in the email opens the app: Android matches an app link
                  against the URL that is tapped, so Supabase's default link to
                  its own /auth/v1/verify could never qualify however it
                  redirected afterwards. The templates in supabase/templates/
                  build the link against this host instead.
                -->
                <data
                    android:scheme="https"
                    android:host="garage.hrva.cc"
                    android:pathPrefix="/auth/confirm"/>
            </intent-filter>
            <!-- Long-pressing the app icon offers "Add a fill-up", which is
                 the thing this app is opened for most often. The shortcut's
                 intent names this activity explicitly, so unlike the filters
                 above it needs no verified web path and cannot lose the tap to
                 a browser. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- The same destination as a home-screen widget, for people who would
             rather not long-press to reach it. It displays a fixed label: a
             widget has no Flutter engine and therefore no data. See
             LogFuelWidget.kt and decision 58. -->
        <receiver
            android:name=".LogFuelWidget"
            android:label="@string/widget_log_fuel_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/log_fuel_widget_info" />
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Required for url_launcher to resolve a mailto: link (the About
             screen's "Send feedback" row) on Android 11+, where package
             visibility is restricted by default. Without this the mail app
             is invisible to a query even though it is installed, and the
             link silently fails to open. -->
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="mailto"/>
        </intent>
    </queries>
</manifest>
